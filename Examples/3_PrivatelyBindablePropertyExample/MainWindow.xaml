<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PrivatelyBindablePropertyExample" x:Class="PrivatelyBindablePropertyExample.MainWindow"
        mc:Ignorable="d"
        Title="PrivatelyBindableProperty Example" Height="450" Width="700" WindowStartupLocation="CenterScreen">
    <Grid>
        <Button Content="Set height" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="146,284,0,0" Click="AppleSetHeightButton_Click"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Margin="26,22,0,0" Height="187" Width="592"><Run Text="Example 3)"/><Run Text=" This example demonstrates the "/><Run Text="use of "/><Run Text="public SetValue method"/><Run Text=" "/><Run Text="of PrivatelyBindableProperty class"/><Run Text="."/><LineBreak/><Run/><LineBreak/><Run Text="* There are two instances of YourClass class here. Their names are Apple and Tomato."/><LineBreak/><Run Text="* "/><Run Text="You can set a new value to bindable property by entering it into the textbox and click the "/><Run Text="&quot;"/><Run Text="Set"/><Run Text=" height&quot;"/><Run Text=" button. T"/><Run Text="he Changed property event handler in YourClass will announce the new height value."/><LineBreak/><LineBreak/><Run Text="* Please see the ReadMe.txt for more info about how to implement bindable propert"/><Run Text="ies"/><Run Text=" in your own classes."/></TextBlock>
        <Label Content="Apple" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="3.584,7.149" Margin="177.117,229,0,0" Width="75" Height="24" FontWeight="Bold"/>
        <Button Content="Set height" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="419,284,0,0" Click="TomatoSetHeightButton_Click"/>
        <Label Content="Tomato" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="3.584,7.149" Margin="434.117,229,0,0" Width="75" Height="24" FontWeight="Bold"/>
        <Button x:Name="BindButton" Content="Bind" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="294.117,214,0,0" Click="BindButton_Click"/>
        <Button x:Name="UnbindButton" Content="Unbind" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="294.117,243,0,0" Click="UnbindButton_Click"/>
        <Image HorizontalAlignment="Left" Height="19" VerticalAlignment="Top" Width="34" Source="/PrivatelyBindablePropertyExample;component/Arrow.png" Margin="383.117,234,0,0"/>
        <Image HorizontalAlignment="Left" Height="19" VerticalAlignment="Top" Width="34" Source="/PrivatelyBindablePropertyExample;component/Arrow.png" Margin="252.117,234,0,0"/>
        <TextBox x:Name="AppleHeightTextBox" HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" VerticalAlignment="Top" Width="54" Margin="164,258,0,0" Text="{Binding AppleHeightTextBoxValue, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBox x:Name="TomatoHeightTextBox" HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" VerticalAlignment="Top" Width="54" Margin="443,258,0,0" Text="{Binding TomatoHeightTextBoxValue, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:MainWindow}}, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</Window>
