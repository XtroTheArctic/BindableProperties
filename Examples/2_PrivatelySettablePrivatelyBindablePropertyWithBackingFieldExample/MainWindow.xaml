<Window x:Class="PrivatelySettablePrivatelyBindablePropertyWithBackingFieldExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrivatelySettablePrivatelyBindableProperty With Backing Field Example" Height="450" Width="700" WindowStartupLocation="CenterScreen">
    <Grid>
        <Button Content="Grow by one" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="146.117,253,0,0" Click="AppleGrowButton_Click"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Margin="26,22,0,0" Height="187" Width="592"><Run Text="Example "/><Run Text="2"/><Run Text=")"/><Run Text=" This example "/><Run Text="shows how to define a backing field for a bindable property and use it when needed"/><Run Text="."/><LineBreak/><Run/><LineBreak/><Run Text="* There are two instances of YourClass class here. Their names are Apple and Tomato."/><LineBreak/><Run/><LineBreak/><Run Text="* When you click command buttons (Grow and Die), the Changed property event handler in YourClass will "/><Run Text="be able to increase the current value by one because it stores the current value in a backing field"/><Run Text="."/><LineBreak/><LineBreak/><Run Text="* The new value of the bindable properties will be captured by this window via Changed event and be displayed on the labels."/><LineBreak/><Run/><LineBreak/><Run Text="* Please see the ReadMe.txt of first example for more info about how to implement bindable property"/><Run Text="ies"/><Run Text=" in your own classes."/></TextBlock>
        <Label Content="Apple" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="3.584,7.149" Margin="177.117,229,0,0" Width="75" Height="24" FontWeight="Bold"/>
        <Button Content="Die" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="146.117,278,0,0" Click="AppleDieButton_Click"/>
        <Button Content="Grow by one" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="419.117,253,0,0" Click="TomatoGrowButton_Click"/>
        <Label Content="Tomato" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="3.584,7.149" Margin="434.117,229,0,0" Width="75" Height="24" FontWeight="Bold"/>
        <Button Content="Die" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="419.117,278,0,0" Click="TomatoDieButton_Click"/>
        <Button x:Name="BindButton" Content="Bind" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="294.117,214,0,0" Click="BindButton_Click"/>
        <Button x:Name="UnbindButton" Content="Unbind" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="294.117,243,0,0" Click="UnbindButton_Click"/>
        <Image HorizontalAlignment="Left" Height="19" VerticalAlignment="Top" Width="34" Margin="383.117,234,0,0" Source="/PrivatelySettablePrivatelyBindablePropertyWithBackingFieldExample;component/Arrow.png"/>
        <Image HorizontalAlignment="Left" Height="19" VerticalAlignment="Top" Width="34" Source="/PrivatelySettablePrivatelyBindablePropertyWithBackingFieldExample;component/Arrow.png" Margin="252.117,234,0,0"/>
        <Label Content="Height:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="146,303,0,0"/>
        <Label Content="Height:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="419,303,0,0"/>
        <Label x:Name="AppleHeightLabel" Content="Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="191,303,0,0"/>
        <Label x:Name="TomatoHeightLabel" Content="Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="464,303,0,0"/>
