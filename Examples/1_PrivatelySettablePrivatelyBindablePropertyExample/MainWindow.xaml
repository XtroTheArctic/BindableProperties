<Window x:Class="PrivatelySettablePrivatelyBindablePropertyExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrivatelySettablePrivatelyBindableProperty Example" Height="450" Width="700" WindowStartupLocation="CenterScreen">
    <Grid>
        <Button Content="Grow randomly" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="146,268,0,0" Click="AppleGrowButton_Click"/>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Margin="26,10,0,0" Height="214" Width="652"><Run Text="Example 1)"/><Run Text=" This example demonstrates the binding ability of the properties provided in Bindable Properties system."/><LineBreak/><Run/><LineBreak/><Run Text="* There are two instances of YourClass class here. Their names are Apple and Tomato."/><LineBreak/><Run Text="* When you click command buttons (Grow and Die), the Changed property event handler in YourClass will announce the new height value."/><LineBreak/><Run Text="* If you bind Apple"/><Run Text="'s "/><Run Text="height property"/><Run Text=" "/><Run Text="to Tomato's height property, you can see that Apple will announce its value when you send "/><Run Text="a "/><Run Text="command to Tomato."/><LineBreak/><Run/><LineBreak/><Run Text="* Please see the ReadMe.txt for more info about how to implement bindable property"/><Run Text="ies"/><Run Text=" in your own classes."/><LineBreak/><Run/><LineBreak/><Run Text="* Note:"/><Run Text=" If you don't see an announcement after you click a command button, it means that the randomly generated value was the same with the current property value so the Change event "/><Run Text="didn't "/><Run Text="get triggered by the Bindable Properties system."/></TextBlock>
        <Label Content="Apple" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="3.584,7.149" Margin="177,244,0,0" Width="75" Height="24" FontWeight="Bold"/>
        <Button Content="Die" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="146,293,0,0" Click="AppleDieButton_Click"/>
        <Button Content="Grow randomly" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="419,268,0,0" Click="TomatoGrowButton_Click"/>
        <Label Content="Tomato" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="3.584,7.149" Margin="434,244,0,0" Width="75" Height="24" FontWeight="Bold"/>
        <Button Content="Die" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="419,293,0,0" Click="TomatoDieButton_Click"/>
        <Button x:Name="BindButton" Content="Bind" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="294,229,0,0" Click="BindButton_Click"/>
        <Button x:Name="UnbindButton" Content="Unbind" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="294,258,0,0" Click="UnbindButton_Click"/>
        <Image HorizontalAlignment="Left" Height="19" VerticalAlignment="Top" Width="34" Source="Arrow.png" Margin="383,249,0,0"/>
        <Image HorizontalAlignment="Left" Height="19" VerticalAlignment="Top" Width="34" Source="Arrow.png" Margin="252,249,0,0"/>
    </Grid>
</Window>
